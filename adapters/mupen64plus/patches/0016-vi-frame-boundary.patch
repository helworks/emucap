+/* emucap: titles that drive the RDP directly (libdragon) never submit an OSTask graphics task.
+ * EMUCAP_N64_FRAME_BOUNDARY=vi reports one frame per vertical interrupt instead. The value is
+ * fixed for the process and read once. */
+int main_emucap_vi_frames(void)
+{
+    static int cached = -1;
+    if (cached < 0) {
+        const char *boundary = SDL_getenv("EMUCAP_N64_FRAME_BOUNDARY");
+        cached = boundary != NULL && strcmp(boundary, "vi") == 0;
+    }
+    return cached;
+}
