     uint32_t reg = pi_reg(address);
 
+    /* emucap: offsets past the last PI register (libdragon samples 0x04600034 for entropy) read
+     * as zero instead of the controller's host pointers. */
+    if (reg >= PI_REGS_COUNT) {
+        *value = 0;
+        return;
+    }
+
