+    uint32_t pending_sp_intr = sp->mi->regs[MI_INTR_REG] & MI_INTR_SP;
+    uint32_t rsp_raised;
+
+    sp->mi->regs[MI_INTR_REG] &= ~MI_INTR_SP;
 
     if (sp->mem[0xfc0/4] == 1)
