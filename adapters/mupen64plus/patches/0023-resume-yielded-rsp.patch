+    rsp_raised = sp->mi->regs[MI_INTR_REG] & MI_INTR_SP;
+    sp->mi->regs[MI_INTR_REG] &= ~MI_INTR_SP;
+    sp->mi->regs[MI_INTR_REG] |= pending_sp_intr;
