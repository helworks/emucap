emucap: honor XKPHYS addresses in R4300 loads and stores.

libdragon reads PI space (rompak TOC, IO registers) through uncached XKPHYS addresses such as
0x9000000010001000. The core truncated every effective address to 32 bits, turning these into
TLB-mapped KUSEG accesses and a fatal TLB exception. Map XKPHYS to the same physical address
through KSEG1; every other address keeps the existing 32-bit behavior.

--- a/src/device/r4300/r4300_core.h
+++ b/src/device/r4300/r4300_core.h
@@ -254,4 +254,15 @@
 
 void savestates_load_set_pc(struct r4300_core* r4300, uint32_t pc);
 
+/* emucap: CPU load/store effective address. 64-bit XKPHYS addresses (bits 63..62 == 0b10), as
+ * used by libdragon to reach PI space, map to their physical address through KSEG1. Other
+ * addresses keep the 32-bit truncation used by the rest of the core. */
+static osal_inline uint32_t r4300_emucap_lsaddr(int64_t base, int64_t offset)
+{
+    uint64_t address = (uint64_t)(base + offset);
+    if ((address >> 62) == 2 && (address & UINT64_C(0x07FFFFFFE0000000)) == 0)
+        return UINT32_C(0xA0000000) | (uint32_t)(address & UINT32_C(0x1FFFFFFF));
+    return (uint32_t)address;
+}
+
 #endif
