 }
@@ -95,6 +97,25 @@
     qemu_cond_broadcast(&d->pfifo.fifo_cond);
 }
 
+/*
+ * emucap: under icount the guest must not observe how far the host FIFO thread got. After a
+ * vCPU register write releases FIFO work, wait (BQL released, pfifo.lock held as by the caller)
+ * until the pusher and puller report idle, i.e. ran out of commands or stalled on guest-time
+ * events such as a flip or an interrupt acknowledgement. GPU writes to guest memory, GET
+ * pointers, notifiers and interrupts then land at the same guest instruction on every run.
+ */
+void pfifo_emucap_drain(NV2AState *d)
+{
+    if (!icount_enabled() || !d->pfifo.fifo_kick || !bql_locked()) {
+        return;
+    }
+    bql_unlock();
+    while (d->pfifo.fifo_kick && !d->exiting) {
+        qemu_cond_wait(&d->pfifo.fifo_idle_cond, &d->pfifo.lock);
+    }
+    bql_lock();
+}
+
 static bool can_fifo_access(NV2AState *d) {
     return qatomic_read(&d->pgraph.regs_[NV_PGRAPH_FIFO]) &
            NV_PGRAPH_FIFO_ACCESS;
